[
  {
    "context": "Editor",
    "unbind": {
      "f9": "editor::ToggleBreakpoint",
    },
  },
  {
    "bindings": {
      "f9": [
        "action::Sequence",
        [
          "terminal_panel::ToggleFocus",
          ["terminal::SendKeystroke", "up"],
          ["terminal::SendKeystroke", "enter"],
        ],
      ],
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g b": "vim::SelectNext",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-shift-space": "terminal::ToggleViMode"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-q": "editor::Rewrap"
    },
    "unbind": {
      "cmd-k q": "editor::Rewrap"
    }
  },
  {
      "context": "Workspace",
      "bindings": {
        "cmd-h": "tab_switcher::Toggle",
        "cmd-l": "tab_switcher::ToggleAll",
        "cmd-shift-d": "git_panel::ToggleFocus",
        "cmd-shift-h": "workspace::ToggleLeftDock",
        "cmd-shift-r": "search::ToggleReplace",
        "cmd-shift-l": "workspace::ToggleRightDock",
        "alt-cmd-shift-l": "multi_workspace::ToggleWorkspaceSidebar",
        "cmd-shift-j": "agents_sidebar::ToggleThreadSwitcher",
        "cmd-shift-k": ["agents_sidebar::ToggleThreadSwitcher", { "select_last": true }]
      },
      "unbind": {
        "cmd-h": "zed::Hide",
        "cmd-l": "agent::ToggleFocus",
        "cmd-shift-j": "agent::OpenSettings",
        "cmd-shift-h": "search::ToggleReplace",
        "cmd-shift-d": "debug_panel::ToggleFocus",
        "alt-cmd-j": "multi_workspace::ToggleWorkspaceSidebar"
      }
  },
  {
      "context": "Editor",
      "unbind": {
        "cmd-l": "editor::SelectLine",
        "cmd-shift-k": "editor::DeleteLine",
        "cmd-shift-l": "editor::SelectAllMatches"
      }
    },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "cmd-k": "assistant::InlineAssist",
      "cmd-l": "agent::AddSelectionToThread",
      "cmd-shift-l": "agent::AddSelectionToThread"
    }
  },
  {
    "context": "AgentPanel || MessageEditor > Editor",
    "unbind": {
      "cmd-l": "workspace::ToggleRightDock"
    }
  },
  {
    "unbind": {
      "cmd-h": "zed::Hide"
    }
  },
]
