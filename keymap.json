// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "f9": "editor::ToggleBreakpoint",
    },
  },
  {
    "bindings": {
      "f9": [
        "action::Sequence",
        [
          "terminal_panel::ToggleFocus",
          ["terminal::SendKeystroke", "up"],
          ["terminal::SendKeystroke", "enter"],
        ],
      ],
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g b": "vim::SelectNext",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-shift-space": "terminal::ToggleViMode"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-q": "editor::Rewrap"
    },
    "unbind": {
      "cmd-k q": "editor::Rewrap"
    }
  },
  {
      "context": "Workspace",
      "bindings": {
        "cmd-shift-g": "git_panel::ToggleFocus",
        "cmd-shift-h": "workspace::ToggleLeftDock",
        "cmd-shift-r": "search::ToggleReplace",
        "cmd-shift-l": "multi_workspace::ToggleWorkspaceSidebar",
        "cmd-shift-j": "agents_sidebar::ToggleThreadSwitcher",
        "cmd-shift-k": ["agents_sidebar::ToggleThreadSwitcher", { "select_last": true }]
      },
      "unbind": {
        "cmd-shift-j": "agent::OpenSettings",
        "cmd-shift-h": "search::ToggleReplace",
        "cmd-shift-d": "debug_panel::ToggleFocus",
        "alt-cmd-j": "multi_workspace::ToggleWorkspaceSidebar"
      }
  },
]
